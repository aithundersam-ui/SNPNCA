# Copy to .env and fill in. Never commit the real .env.

# --- Domain and Django
SITE_DOMAIN=adherents.snpnca.dz
SITE_URL=https://adherents.snpnca.dz
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=adherents.snpnca.dz
DJANGO_CSRF_TRUSTED_ORIGINS=https://adherents.snpnca.dz
DJANGO_DEBUG=false

# --- Database (docker-compose builds DATABASE_URL from this)
POSTGRES_PASSWORD=change-me

# --- First Master Admin, created on first start.
# Without MASTER_ADMIN_PASSWORD a set-password link is emailed instead (recommended).
MASTER_ADMIN_EMAIL=president@snpnca.dz
MASTER_ADMIN_NAME=Prénom Nom
MASTER_ADMIN_PASSWORD=

# --- Email (any SMTP provider: Brevo, Mailgun, Gmail Workspace, OVH...)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SNPNCA <no-reply@snpnca.dz>
# Where Contact Us submissions are sent. Defaults to MASTER_ADMIN_EMAIL.
CONTACT_NOTIFY_EMAIL=

# --- Q&A assistant (Claude API). Server-side only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
QA_RATE_LIMIT=20

# --- Limits
MAX_PDF_MB=25
MAX_IMAGE_MB=5
OCR_LANGUAGES=fra+eng+ara
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
